# Discord
DISCORD_TOKEN=put_discord_bot_token_here
# Opcjonalne: do linkow zaproszenia, bot sam ustala ID aplikacji po tokenie.
DISCORD_CLIENT_ID=put_discord_client_id_here
DISCORD_GUILD_ID=put_discord_guild_id_here
# Ustaw true tylko po wlaczeniu tych opcji w Discord Developer Portal.
DISCORD_ENABLE_GUILD_MEMBERS_INTENT=true
DISCORD_ENABLE_MESSAGE_CONTENT_INTENT=false
DISCORD_ENABLE_PRESENCE_INTENT=true
DATA_DIR=/app/data
LOG_DIR=/app/logs
NEW_ACCOUNT_ALERT_CHANNEL_ID=1506378538113040414
NEW_ACCOUNT_ALERT_MAX_AGE_DAYS=30

# Anti-spam
# Wymaga wlaczonego Message Content Intent w Discord Developer Portal.
ANTI_SPAM_ENABLED=true
ANTI_SPAM_DRY_RUN=true
ANTI_SPAM_ACTION=timeout
ANTI_SPAM_ALERT_CHANNEL_ID=1506378538113040414
ANTI_SPAM_ALERT_ROLE_IDS=1506304554315157544
ANTI_SPAM_TRUSTED_ROLE_IDS=1506307087259533393,1506304554315157544
ANTI_SPAM_IGNORED_CHANNEL_IDS=
ANTI_SPAM_IGNORED_CATEGORY_IDS=
ANTI_SPAM_TIMEOUT_MINUTES=30
ANTI_SPAM_DUPLICATE_WINDOW_SECONDS=20
ANTI_SPAM_DUPLICATE_CHANNEL_LIMIT=2
ANTI_SPAM_DUPLICATE_MIN_LENGTH=3
ANTI_SPAM_DUPLICATE_SIMILARITY=0.92
ANTI_SPAM_RATE_LIMIT_COUNT=6
ANTI_SPAM_RATE_LIMIT_SECONDS=10
ANTI_SPAM_ACTION_COOLDOWN_SECONDS=60
ANTI_SPAM_BLOCK_DISCORD_INVITES=true
ANTI_SPAM_BLOCK_SUSPICIOUS_LINKS=true

# PUBG
PUBG_API_KEY=put_pubg_api_key_here
PUBG_PLATFORM=steam
PUBG_REGION=steam
PUBG_CLAN_ID=clan.4708615947dc483c871621fc3b24590f
PUBG_CLAN_TAG=LGN
PUBG_CHICKEN_CHANNEL_ID=1518343160382754816
PUBG_CHICKEN_CHECK_MS=120000
PUBG_CHICKEN_REQUEST_DELAY_MS=7000
PUBG_CHICKEN_MAX_REQUESTS_PER_RUN=8
PUBG_CHICKEN_MATCH_LOOKBACK=5
PUBG_CHICKEN_ANNOUNCE_ON_FIRST_RUN=false

# Twitch. Najlepiej podac CLIENT_ID + CLIENT_SECRET, bot sam pobierze access token.
TWITCH_CLIENT_ID=put_twitch_client_id_here
TWITCH_CLIENT_SECRET=put_twitch_client_secret_here

# Google Sheets
GOOGLE_SPREADSHEET_ID=put_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/google-service-account.json

# WordPress
WP_USER=Sentinel
WP_APP_PASSWORD=put_wordpress_application_password_here
WP_PAGE_URL=https://nationaldevils.eu/wp-json/wp/v2/pages/123
WP_CLAN_ENDPOINT=http://192.168.0.121/wp-json/devs/v1/klan
WP_CLAN_PROMOTION_ENDPOINT=http://192.168.0.121/wp-json/devs/v1/klan-promotion
WP_TIP_ENDPOINT=http://192.168.0.121/wp-json/nationaldevils/v1/tip
WP_EVENTS_URL=http://192.168.0.121/wp-json/nd/v1
WP_EVENTS_TOKEN=put_wordpress_events_token_here
WP_DISCORD_STATS_ENDPOINT=http://192.168.0.121/wp-json/legion/v1/discord-stats
WP_DISCORD_STATS_TOKEN=put_discord_stats_token_from_wp_here

# Discord stats -> WordPress
DISCORD_STATS_ENABLED=true
DISCORD_STATS_TIMEZONE=Europe/Warsaw
DISCORD_STATS_RETENTION_DAYS=365
DISCORD_STATS_FLUSH_MS=60000
DISCORD_STATS_SYNC_MS=60000
DISCORD_STATS_TOP_LIMIT=25
DISCORD_STATS_INCLUDE_BOTS=false
DISCORD_STATS_IGNORED_CHANNEL_IDS=1507287632156295230,1507287703312535633,1507287765996535808,1507287836515368962,1507287993076027462,1506537085794914353
DISCORD_STATS_IGNORED_CATEGORY_IDS=
DISCORD_STATS_IGNORED_USER_IDS=

# Inne integracje
TIPPLY_WIDGET_URL=https://widgets.tipply.pl/TIP_ALERT/your-widget-id/
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Muzyka
# Opcjonalnie ustaw staly kanal tekstowy panelu i staly kanal glosowy.
MUSIC_TEXT_CHANNEL_ID=
MUSIC_VOICE_CHANNEL_ID=
MUSIC_MAX_QUEUE_SIZE=50
MUSIC_SEARCH_LIMIT=5
MUSIC_IDLE_DISCONNECT_MS=300000
MUSIC_VOICE_DEBUG=false
